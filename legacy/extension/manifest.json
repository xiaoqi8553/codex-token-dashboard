{
  "manifest_version": 3,
  "name": "Codex Token Dashboard 本机同步",
  "version": "0.2.0",
  "description": "在 Notion 嵌入看板中安全读取本机 Codex Token 仪表盘数据。",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://127.0.0.1:8788/*",
    "http://127.0.0.1:8789/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://xiaoqi8553.github.io/codex-token-dashboard/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}
