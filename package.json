{
  "name": "codex-token-dashboard",
  "version": "1.0.2",
  "private": false,
  "description": "Local Codex token usage dashboard with official Plus and relay import support.",
  "author": "Xiaoqi",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "start:desktop": "npm run desktop:icon && electron .",
    "desktop:icon": "node desktop/create-icon.cjs",
    "desktop:test": "node --test tests/desktop-status-api.test.js",
    "desktop:smoke": "node scripts/desktop-smoke.js",
    "desktop:dir": "npm run desktop:icon && electron-builder --win --x64 --dir --config desktop/builder.config.cjs",
    "desktop:build": "npm run desktop:icon && electron-builder --win nsis --x64 --config desktop/builder.config.cjs",
    "dev": "node server.js",
    "scan": "node server.js --scan",
    "test": "node --test tests/*.test.js",
    "sync:test": "node scripts/sync-check.js",
    "extension:test": "node scripts/extension-smoke.js",
    "notion:test": "node scripts/notion-local-smoke.js",
    "build": "node scripts/build-static.js",
    "account:bridge": "node scripts/account-bridge.js --open",
    "visual:shot": "node scripts/visual-check.js --shot",
    "visual:test": "node scripts/visual-check.js --test",
    "ui:shot": "node scripts/ui-review.js --shot",
    "ui:audit": "node scripts/ui-review.js --audit",
    "ui:report": "node scripts/ui-review.js --report"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.60.0"
  },
  "license": "MIT"
}
