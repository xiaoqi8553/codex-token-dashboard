{
  "name": "tokenbar",
  "version": "2.0.0",
  "private": false,
  "description": "Windows 托盘里的 token 用量看板：Codex 与 WorkBuddy 的用量、额度窗口、输出速度和等价花费，只读本地日志。",
  "author": "Xiaoqi",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run desktop:icon && electron .",
    "desktop:icon": "node desktop/create-icon.cjs",
    "test": "node --test tests/*.test.js",
    "desktop:smoke": "node scripts/desktop-smoke.js",
    "desktop:dir": "npm run desktop:icon && electron-builder --win --x64 --dir --config desktop/builder.config.cjs",
    "desktop:build": "npm run desktop:icon && electron-builder --win nsis --x64 --config desktop/builder.config.cjs",
    "desktop:shortcut": "electron scripts/make-desktop-shortcut.cjs",
    "popover:shot": "electron scripts/dev-popover-shot.cjs",
    "usage:audit": "node scripts/dev-audit-usage.cjs",
    "usage:verify": "node scripts/verify-usage-merge.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.60.0"
  },
  "license": "MIT"
}
